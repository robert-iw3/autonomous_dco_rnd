# SECTION: bench — WS-A benchmark harness (registry + runner + score-file contract)
#   docker build -f project_empros/tests/Dockerfile.bench -t nexus-test-bench .
FROM docker.io/alpine:3.24

# numpy backs the TurboVec near-duplicate index the leakage gate runs on.
RUN apk add --no-cache python3 py3-pip py3-numpy
ENV PIP_BREAK_SYSTEM_PACKAGES=1 PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
RUN pip3 install --no-cache-dir "pytest>=7.4.0"

# The benchmark runner, eval-QA gates, RSI loop (gate-activation test) and the
# registry they load.
COPY project_empros/mlops/scripts/        /repo/project_empros/mlops/scripts/
COPY project_empros/mlops/benchmarks/     /repo/project_empros/mlops/benchmarks/
COPY project_empros/tests/lab_benchmarks/ /repo/project_empros/tests/lab_benchmarks/
COPY project_empros/tests/pytest.ini      /repo/project_empros/tests/
COPY project_empros/tests/conftest.py     /repo/project_empros/tests/

WORKDIR /repo/project_empros
CMD ["python3", "-m", "pytest", "tests/lab_benchmarks/", \
     "-v", "--tb=short", "--junit-xml=/reports/bench.xml"]
