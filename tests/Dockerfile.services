# SECTION: services
# Tests:   test_worker_contracts, lab_worker_rules/, lab_infra_contracts/,
#          lab_operations_contracts/, lab_orchestration/
# Deps:    pytest only -- all tests do pure source-code reads (no imports of
#          compiled deps); subprocess used to validate cargo check syntax
#   docker build -f autonomous_dco_rnd/tests/Dockerfile.services -t nexus-test-services .
FROM docker.io/alpine:3.23

RUN apk add --no-cache python3 py3-pip

ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN pip3 install --no-cache-dir "pytest>=7.4.0" "PyYAML>=6.0"

# All source trees the contract tests read (no Python imports -- file reads only)
COPY autonomous_dco_rnd/services/           /repo/autonomous_dco_rnd/services/
COPY autonomous_dco_rnd/infrastructure/     /repo/autonomous_dco_rnd/infrastructure/
COPY autonomous_dco_rnd/orchestration/      /repo/autonomous_dco_rnd/orchestration/
COPY autonomous_dco_rnd/operations/         /repo/autonomous_dco_rnd/operations/
COPY autonomous_dco_rnd/middleware/         /repo/autonomous_dco_rnd/middleware/
COPY autonomous_dco_rnd/libs/               /repo/autonomous_dco_rnd/libs/
COPY autonomous_dco_rnd/analytics/llm_hunter/ /repo/autonomous_dco_rnd/analytics/llm_hunter/
COPY autonomous_dco_rnd/mlops/scripts/      /repo/autonomous_dco_rnd/mlops/scripts/
COPY autonomous_dco_rnd/mlops/data/staging/             /repo/autonomous_dco_rnd/mlops/data/staging/
COPY autonomous_dco_rnd/tests/test_worker_contracts.py      /repo/autonomous_dco_rnd/tests/
COPY autonomous_dco_rnd/tests/test_s3_query_alignment.py    /repo/autonomous_dco_rnd/tests/
COPY autonomous_dco_rnd/tests/docker-compose.yml            /repo/autonomous_dco_rnd/tests/
COPY autonomous_dco_rnd/tests/lab_worker_rules/             /repo/autonomous_dco_rnd/tests/lab_worker_rules/
COPY autonomous_dco_rnd/tests/lab_infra_contracts/          /repo/autonomous_dco_rnd/tests/lab_infra_contracts/
COPY autonomous_dco_rnd/tests/lab_operations_contracts/     /repo/autonomous_dco_rnd/tests/lab_operations_contracts/
COPY autonomous_dco_rnd/tests/lab_orchestration/            /repo/autonomous_dco_rnd/tests/lab_orchestration/
COPY autonomous_dco_rnd/tests/lab_nats_ingress/nats-test.conf /repo/autonomous_dco_rnd/tests/lab_nats_ingress/
COPY autonomous_dco_rnd/tests/deploy/                       /repo/autonomous_dco_rnd/tests/deploy/
COPY autonomous_dco_rnd/tests/pytest.ini                    /repo/autonomous_dco_rnd/tests/
COPY autonomous_dco_rnd/tests/conftest.py                    /repo/autonomous_dco_rnd/tests/

ENV PYTHONPATH=/repo/autonomous_dco_rnd
WORKDIR /repo/autonomous_dco_rnd

CMD ["python3", "-m", "pytest", \
     "tests/test_worker_contracts.py", \
     "tests/lab_worker_rules/", \
     "tests/lab_infra_contracts/", \
     "tests/lab_operations_contracts/", \
     "tests/lab_orchestration/", \
     "-v", "--tb=short", "--junit-xml=/reports/services.xml"]
