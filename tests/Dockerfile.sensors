# SECTION: sensors
# Tests:   tests/sensors/* (all sensor pipeline schema + vector validation)
# Deps:    pytest, numpy, pyarrow, pandas, pydantic
#   docker build -f autonomous_dco_rnd/tests/Dockerfile.sensors -t nexus-test-sensors .
FROM docker.io/alpine:3.24

RUN apk add --no-cache \
    python3 python3-dev py3-pip \
    gcc g++ musl-dev linux-headers libffi-dev openssl-dev

ENV PIP_BREAK_SYSTEM_PACKAGES=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN pip3 install --no-cache-dir \
    "pytest>=7.4.0" \
    "numpy>=2.0.0" \
    "pyarrow>=16.0.0" \
    "pandas>=2.2.0" \
    "pydantic>=2.7.1" \
    "requests>=2.31.0"

# autonomous_dco_rnd source
COPY autonomous_dco_rnd/mlops/scripts/                      /repo/autonomous_dco_rnd/mlops/scripts/
COPY autonomous_dco_rnd/mlops/config/                       /repo/autonomous_dco_rnd/mlops/config/
COPY autonomous_dco_rnd/services/config/                    /repo/autonomous_dco_rnd/services/config/
COPY autonomous_dco_rnd/services/worker_qdrant/             /repo/autonomous_dco_rnd/services/worker_qdrant/
COPY autonomous_dco_rnd/tests/config/                       /repo/autonomous_dco_rnd/tests/config/
COPY autonomous_dco_rnd/tests/deploy/                       /repo/autonomous_dco_rnd/tests/deploy/
COPY autonomous_dco_rnd/tests/sensors/                      /repo/autonomous_dco_rnd/tests/sensors/
COPY autonomous_dco_rnd/tests/lab_sensor_transmission/      /repo/autonomous_dco_rnd/tests/lab_sensor_transmission/
COPY autonomous_dco_rnd/tests/test_e2e_sensor_pipeline.py   /repo/autonomous_dco_rnd/tests/
COPY autonomous_dco_rnd/tests/pytest.ini                    /repo/autonomous_dco_rnd/tests/
COPY autonomous_dco_rnd/tests/conftest.py                   /repo/autonomous_dco_rnd/tests/

# Repo-root sensor sources (linux/c2_sensor, linux/sentinel, linux/suricata,
# infra/aws, infra/azure, infra/gcp, infra/network_tap, windows/).
# Tests read Cargo.toml + *.rs source files via ROOT = REPO.parent.
# Large data/ and img/ dirs are excluded via .dockerignore.
COPY infra/     /repo/infra/
COPY linux/     /repo/linux/
COPY windows/   /repo/windows/

ENV PYTHONPATH=/repo/autonomous_dco_rnd/mlops/scripts:/repo/autonomous_dco_rnd
WORKDIR /repo/autonomous_dco_rnd

CMD ["python3", "-m", "pytest", \
     "tests/sensors/", \
     "tests/lab_sensor_transmission/", \
     "tests/test_e2e_sensor_pipeline.py", \
     "-v", "--tb=short", "--junit-xml=/reports/sensors.xml"]
